{
  "name": "@nettoscorp/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "NettosCorp Enterprise — shared design tokens (colors, spacing, typography) as CSS custom properties + Sass settings for USWDS integration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": {
      "import": "./dist/css.js"
    },
    "./theme": {
      "import": "./dist/theme.js"
    },
    "./sass/*": {
      "import": "./dist/sass/*.js"
    }
  },
  "files": ["dist", "src", "_uswds-theme.scss", "_tokens.scss"],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "tsup --watch",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {},
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0"
  }
}

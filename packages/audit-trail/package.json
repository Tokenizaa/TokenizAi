{
  "name": "@nettoscorp/audit-trail",
  "version": "0.1.0",
  "private": true,
  "description": "NettosCorp Enterprise — immutable audit trail with verifiable SHA-256 hash chain and compliance reporting (SOC 2 CC6.1/CC7.1/CC7.2, ISO 27001)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nettoscorp/shared": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}

{
  "name": "@nettoscorp/authority-engine",
  "version": "0.1.0",
  "private": true,
  "description": "NettosCorp Enterprise — Authority Engine: JWT governance, refresh rotation, revocation, authority/clearance checks and separation of duties (Fase 8)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nettoscorp/auth": "workspace:*",
    "@nettoscorp/shared": "workspace:*",
    "@nettoscorp/db": "workspace:*",

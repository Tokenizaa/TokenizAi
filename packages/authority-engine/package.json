    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@nettoscorp/auth": "workspace:*",
    "@nettoscorp/shared": "workspace:*",
    "@nettoscorp/db": "workspace:*"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}

{
  "name": "@nettoscorp/catalog-sync",
  "version": "0.1.0",
  "private": true,
  "description": "NettosCorp Enterprise — Pipeline de sincronización del catálogo Agency Agents (GitHub webhook → diff → sync → notificación, con rollback del corpus-baseline)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sync-orchestrator": {
      "types": "./dist/sync-orchestrator.d.ts",
      "import": "./dist/sync-orchestrator.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "zod": "^3.23.0",
    "@nettoscorp/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsup": "^8.0.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.14.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

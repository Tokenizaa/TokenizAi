# NettosCorp Enterprise — Variáveis de ambiente do Backend
# Copie para .env e preencha com valores reais. Nunca commite este arquivo.

# --- Supabase (fonte de verdade de dados e identidade) ---
SUPABASE_URL=https://udeglcdloehagljrrukj.supabase.co
SUPABASE_ANON_KEY=seu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=seu_service_role_key_aqui

# --- JWT (assine os tokens de sessão) ---
JWT_SECRET=minha_chave_secreta_de_32_caracteres_minimo
JWT_ISSUER=tokenizai.nettoscorp.example.br
JWT_AUDIENCE=tokenizai-app

# --- Paperclip (motor operacional dos agentes) ---
PAPERCLIP_API_URL=https://api.paperclip.internal/v1
PAPERCLIP_API_KEY=sua_chave_do_paperclip

# --- App ---
PORT=3000
APP_URL=http://localhost:3000
ENVIRONMENT=development

# --- Gemini (IA para chatbot, opcional nas fases iniciais) ---
GEMINI_API_KEY=sua_chave_do_gemini
